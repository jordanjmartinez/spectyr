{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectyr scenario file (schema v2)",
  "$comment": "Phase 2 Stage 0: a scenario is an environment with an attack inside it, not a bare chain. The v1 schema (schema.json) stays frozen as the revert path; the attack steps here are the v1 chain steps plus per-step id/host/user tags. Loader: scenario_loader_v2.py.",
  "type": "object",
  "required": ["schema_version", "label", "category", "difficulty", "threat_pattern", "narrative", "entities", "environment", "attack", "noise", "detections", "answer_key", "triage_review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "label": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "category": {
      "enum": [
        "Malware", "Phishing", "Defense Evasion", "Lateral Movement",
        "Command & Control", "Brute Force", "Data Exfiltration",
        "Insider Threat", "False Positive"
      ]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "threat_pattern": { "type": "string", "minLength": 1 },
    "narrative": {
      "type": "object",
      "required": ["ticket_title", "storyline"],
      "additionalProperties": false,
      "properties": {
        "ticket_title": { "type": "string", "minLength": 1 },
        "storyline": { "type": "string", "minLength": 1 }
      }
    },
    "entities": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!infra$)[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/entity" }
    },
    "environment": {
      "type": "object",
      "required": ["org", "hosts", "accounts"],
      "additionalProperties": false,
      "properties": {
        "org": {
          "type": "object",
          "required": ["name", "domain"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "domain": { "type": "string", "minLength": 1 }
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/host" }
        },
        "accounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/account" }
        }
      }
    },
    "attack": {
      "$comment": "The v1 chain, unchanged in structure; each step additionally carries a stable id and the environment host (and account, when one applies) it occurs on.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attack_step" }
    },
    "noise": {
      "$comment": "Per-host noise profile references. Profiles are defined in Stage 1; until then this stays empty ({}) in every scenario.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_profiles": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supplemental_events": {
      "$comment": "Stage 2 density: authored benign telemetry, sibling to attack. Merged into the session pool (same seed, frozen clock, placeholders, sanitization, integrity). Referenceable by detections via stable id (sup*). Unlike noise (generated, unreferenced), these are authored and referenceable. offset is authored, relative to the attack base time, and may be negative.",
      "type": "array",
      "items": { "$ref": "#/$defs/supplemental_event" }
    },
    "supplemental_entities": {
      "$comment": "One-off external actors a supplemental event references (type, value, internal description). Recurring internal actors go canonical in the reference environment instead. Every entity referenced by any event must resolve here or in the canonical environment.",
      "type": "array",
      "items": { "$ref": "#/$defs/supplemental_entity" }
    },
    "detections": {
      "$comment": "Stage 2: the raw detections this scenario surfaces in the feed. Each fires on triggering step id(s) and carries a server-side answer-key disposition that must never reach the client.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/detection" }
    },
    "answer_key": {
      "type": "object",
      "required": ["classification", "scope", "root_cause", "techniques", "actions"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "A False Positive has no patient zero: root_cause MUST be null. Enforced at the schema level, not only in loader code.",
          "if": {
            "properties": { "classification": { "const": "False Positive" } },
            "required": ["classification"]
          },
          "then": {
            "properties": { "root_cause": { "const": null } }
          }
        }
      ],
      "properties": {
        "classification": {
          "enum": [
            "Malware", "Phishing", "Defense Evasion", "Lateral Movement",
            "Command & Control", "Brute Force", "Data Exfiltration",
            "Insider Threat", "False Positive"
          ]
        },
        "scope": {
          "type": "object",
          "required": ["hosts", "accounts"],
          "additionalProperties": false,
          "properties": {
            "hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "accounts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        "root_cause": {
          "$comment": "Step id of patient zero. null for False Positive scenarios only.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/id" }
          ]
        },
        "techniques": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
        },
        "actions": {
          "$comment": "Reserved for Stage 3 (response action scoring). Must stay empty until the action grammar is defined there; maxItems 0 makes early authoring fail loudly.",
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "triage_review": {
      "type": "object",
      "required": ["what_is_it", "response_actions"],
      "additionalProperties": false,
      "properties": {
        "mitre": {
          "type": "object",
          "required": ["id", "name", "tactic", "url"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
            "name": { "type": "string" },
            "tactic": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "what_is_it": {
          "type": "object",
          "required": ["title", "description"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "response_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "detection": {
      "type": "object",
      "required": ["id", "rule_name", "rule_type", "severity", "triggers", "description", "disposition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rule_name": { "type": "string", "minLength": 1 },
        "rule_type": {
          "$comment": "sigma_behavioral = Sigma-style behavioral rule; yara = simulated YARA signature hit. Rule names/descriptions are original (no SigmaHQ rule text copied), so DRL attribution does not attach.",
          "enum": ["sigma_behavioral", "yara"]
        },
        "severity": { "enum": ["critical", "high", "medium"] },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "mitre": {
          "type": "object",
          "required": ["id", "tactic"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
            "tactic": { "type": "string", "minLength": 1 }
          }
        },
        "yara_rule_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "disposition": {
          "$comment": "ANSWER KEY, server-side only. Never serialized to the client.",
          "enum": ["true_positive", "false_positive", "benign_expected"]
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["employee", "external_ip", "internal_host", "domain", "file", "hash"]
        },
        "value": { "type": "string" },
        "hostname": { "type": "string" },
        "ip": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "required": ["id", "role", "hostname", "ip", "os"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": ["workstation", "dc", "file", "dns", "print", "web", "proxy", "backup", "scanner", "firewall", "server"]
        },
        "hostname": { "type": "string", "minLength": 1 },
        "ip": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "desc": { "type": "string" },
        "status": {
          "$comment": "Scenario-declared, never generated. Defaults to online when omitted. Offline carries gameplay meaning later (an offline host cannot be isolated).",
          "enum": ["online", "offline"]
        }
      }
    },
    "account": {
      "type": "object",
      "required": ["id", "username", "domain", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "username": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "type": { "enum": ["user", "admin", "service"] },
        "host": { "$ref": "#/$defs/id" },
        "groups": {
          "$comment": "World-visible group membership (authorization evidence). Optional; canonical service/admin accounts carry it.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supplemental_entity": {
      "type": "object",
      "required": ["id", "type", "value", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["external_ip", "domain", "url", "hash"] },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "supplemental_event": {
      "$comment": "Same renderable shape as an attack step, tagged with a host, but its offset is relative to the attack base time and may be negative. No trigger field: supplemental events are not analyst entry points. No disposition/answer field ever. red_herring is a narrative declaration reviewed at approval; any supplemental event within the attack's plausible correlation window MUST set it true (see docs/classification-rubrics.md).",
      "type": "object",
      "required": ["id", "host", "offset", "event_type", "source_type", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sup[0-9a-z_]*$" },
        "host": { "$ref": "#/$defs/id" },
        "user": { "$ref": "#/$defs/id" },
        "offset": { "type": "number" },
        "red_herring": { "type": "boolean" },
        "event_type": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "log_source": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "hostname": { "type": "string" },
        "source_ip": { "type": "string" },
        "destination_ip": { "type": "string" },
        "user_account": { "type": "string" },
        "message": { "type": "string", "minLength": 1 },
        "key_value_pairs": { "type": "object" }
      }
    },
    "attack_step": {
      "type": "object",
      "required": ["id", "host", "offset", "event_type", "source_type", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "host": { "$ref": "#/$defs/id" },
        "user": { "$ref": "#/$defs/id" },
        "offset": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "event_type": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "log_source": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "trigger": { "type": "boolean" },
        "hostname": { "type": "string" },
        "source_ip": { "type": "string" },
        "destination_ip": { "type": "string" },
        "user_account": { "type": "string" },
        "message": { "type": "string", "minLength": 1 },
        "key_value_pairs": { "type": "object" }
      }
    }
  }
}
